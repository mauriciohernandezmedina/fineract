{
  "name": "Fineract 1.15 Native",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bullseye",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [8080, 8443, 5432],
  "portsAttributes": {
    "8080": {
      "label": "Fineract HTTP API",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "PostgreSQL Local",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    "GRADLE_OPTS": "-Xmx1024m -XX:MaxMetaspaceSize=512m",
    "FINERACT_HIKARI_DRIVER_SOURCE_CLASS_NAME": "org.postgresql.Driver",
    "FINERACT_HIKARI_JDBC_URL": "jdbc:postgresql://localhost:5432/fineract_tenants",
    "FINERACT_HIKARI_USERNAME": "postgres",
    "FINERACT_HIKARI_PASSWORD": "postgres",
    "FINERACT_DEFAULT_TENANTDB_PORT": "5432",
    "FINERACT_DEFAULT_TENANTDB_UID": "postgres",
    "FINERACT_DEFAULT_TENANTDB_PWD": "postgres",
    "FINERACT_DEFAULT_TENANTDB_HOSTNAME": "localhost",
    "FINERACT_SERVER_SSL_ENABLED": "false",
    "FINERACT_SERVER_PORT": "8080"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "sudo service postgresql start",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "humao.rest-client"
      ],
      "settings": {
        "java.import.gradle.wrapper.enabled": true,
        "java.jdt.ls.vmargs": "-XX:+UseG1GC -Dsun.zip.disableMemoryMapping=true -Xmx2G -Xms512m",
        "gradle.nestedProjects": false
      }
    }
  }
}
