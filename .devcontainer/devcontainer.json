{
  "name": "Fineract 1.15 Native (PostgreSQL)",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bullseye",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [8080, 5432],
  "portsAttributes": {
    "8080": {
      "label": "Fineract HTTP API",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "PostgreSQL Local",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    "JAVA_HOME": "/usr/lib/jvm/msopenjdk-current",
    "GRADLE_OPTS": "-Xmx1024m -XX:MaxMetaspaceSize=512m -Dorg.gradle.daemon=true",
    "FINERACT_HIKARI_DRIVER_SOURCE_CLASS_NAME": "org.postgresql.Driver",
    "FINERACT_HIKARI_JDBC_URL": "jdbc:postgresql://localhost:5432/fineract_tenants",
    "FINERACT_HIKARI_USERNAME": "postgres",
    "FINERACT_HIKARI_PASSWORD": "postgres",
    "FINERACT_DEFAULT_TENANTDB_PORT": "5432",
    "FINERACT_DEFAULT_TENANTDB_UID": "postgres",
    "FINERACT_DEFAULT_TENANTDB_PWD": "postgres",
    "FINERACT_DEFAULT_TENANTDB_HOSTNAME": "localhost",
    "FINERACT_SERVER_SSL_ENABLED": "false",
    "FINERACT_SERVER_PORT": "8080"
  },
  "onCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "sudo service postgresql start",
  "customizations": {
    "vscode": {
      "extensions": [
        "humao.rest-client"
      ],
      "settings": {
        "java.jdt.ls.java.home": "/usr/lib/jvm/msopenjdk-current",
        "java.import.gradle.java.home": "/usr/lib/jvm/msopenjdk-current",
        "java.autobuild.enabled": false,
        "java.import.gradle.enabled": false,
        "java.gradle.buildServer.enabled": "off",
        "gradle.autoDetect": "off",
        "files.watcherExclude": {
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true,
          "**/build/**": true,
          "**/.gradle/**": true
        }
      }
    }
  }
}
