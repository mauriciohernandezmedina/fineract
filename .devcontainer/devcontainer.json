{
  "name": "Fineract 1.15 (JDK 21 + PostgreSQL 18)",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bookworm",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [8080, 8443, 5432],
  "portsAttributes": {
    "8080": {
      "label": "Fineract HTTP API",
      "onAutoForward": "notify"
    },
    "8443": {
      "label": "Fineract HTTPS API",
      "onAutoForward": "silent"
    },
    "5432": {
      "label": "PostgreSQL 18",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    "DEBIAN_FRONTEND": "noninteractive",
    "JAVA_HOME": "/usr/lib/jvm/msopenjdk-current",
    "GRADLE_OPTS": "-Xmx256m -Dorg.gradle.daemon=true",
    "FINERACT_HIKARI_DRIVER_SOURCE_CLASS_NAME": "org.postgresql.Driver",
    "FINERACT_HIKARI_JDBC_URL": "jdbc:postgresql://localhost:5432/fineract_tenants",
    "FINERACT_HIKARI_USERNAME": "postgres",
    "FINERACT_HIKARI_PASSWORD": "postgres",
    "FINERACT_DEFAULT_TENANTDB_HOSTNAME": "localhost",
    "FINERACT_DEFAULT_TENANTDB_PORT": "5432",
    "FINERACT_DEFAULT_TENANTDB_UID": "postgres",
    "FINERACT_DEFAULT_TENANTDB_PWD": "postgres",
    "FINERACT_DEFAULT_TENANTDB_NAME": "fineract_default",
    "FINERACT_DEFAULT_TENANTDB_IDENTIFIER": "default",
    "FINERACT_SERVER_SSL_ENABLED": "false",
    "FINERACT_SERVER_PORT": "8080",
    "FINERACT_LIQUIBASE_ENABLED": "true"
  },
  "postCreateCommand": "sed -i 's/\\r$//' .devcontainer/setup.sh && bash .devcontainer/setup.sh",
  "postStartCommand": "sudo service postgresql start || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "humao.rest-client"
      ],
      "settings": {
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-21",
            "path": "/usr/lib/jvm/msopenjdk-current",
            "default": true
          }
        ],
        "java.import.gradle.java.home": "/usr/lib/jvm/msopenjdk-current",
        "java.autobuild.enabled": false,
        "java.import.gradle.enabled": false,
        "java.gradle.buildServer.enabled": "off",
        "gradle.autoDetect": "off",
        "gradle.disable": true,
        "files.watcherExclude": {
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true,
          "**/build/**": true,
          "**/.gradle/**": true
        }
      }
    }
  }
}
